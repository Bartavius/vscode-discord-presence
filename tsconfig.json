{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node", "vscode"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src", "test"]
}
